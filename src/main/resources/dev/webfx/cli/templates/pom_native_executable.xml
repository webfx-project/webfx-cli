<?xml version="1.0" encoding="UTF-8"?>
<!-- File managed by WebFX (DO NOT EDIT MANUALLY) -->
<project>

    <name>${application.name}</name>

    <dependencies/>

    <profiles>
        <!-- Builds the native desktop executable with GraalVM native-image (GraalVM without JavaFX in its JDK, ex: GraalVM Community, installed by webfx install graalvm; see dev.webfx.cli.core.GraalVm) -->
        <!-- Usage: mvn -P native-desktop package => target/${application.name}(.exe) -->
        <profile>
            <id>native-desktop</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.18</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${application.name}</imageName>
                            <mainClass>${webfx.mainClass}</mainClass>
                            ${plugin.native.configuration}
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- The reflection & resources metadata required by native-image is generated by WebFX in -->
    <!-- src/main/resources/META-INF/native-image/ and automatically picked up by native-image -->

</project>
