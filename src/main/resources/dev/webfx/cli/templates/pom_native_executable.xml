<?xml version="1.0" encoding="UTF-8"?>
<!-- File managed by WebFX (DO NOT EDIT MANUALLY) -->
<project>

    <name>${application.name}</name>

    <dependencies/>

    <profiles>
        <!-- Builds the native desktop executable with GraalVM native-image (GraalVM without JavaFX in its JDK, ex: GraalVM Community, installed by webfx install graalvm; see dev.webfx.cli.core.GraalVm) -->
        <!-- Usage: mvn -P native-desktop package => target/${application.name}(.exe) -->
        <profile>
            <id>native-desktop</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.18</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${application.name}</imageName>
                            <mainClass>${webfx.mainClass}</mainClass>
                            ${plugin.native.configuration}
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Builds a GraalVM Native Image layer (shared library), or the executable on top of a layer, for webfx build -n per-package (experimental) -->
        <!-- Invoked by the WebFX CLI once per layer, with the same classpath for all (see dev.webfx.cli.commands.NativeLayersBuild): -->
        <!-- mvn -P native-desktop-layer native:compile-no-fork@build-native-layer -Dwebfx.native.layer.imageName=... -Dwebfx.native.layer.mainClass=... -Dwebfx.native.layer.args=... -->
        <profile>
            <id>native-desktop-layer</id>
            <properties>
                <webfx.native.layer.imageName>${application.name}</webfx.native.layer.imageName>
                <!-- "." = no main class (for a layer) -->
                <webfx.native.layer.mainClass>${webfx.mainClass}</webfx.native.layer.mainClass>
                <!-- native-image arguments, separated by spaces (ex: -H:LayerCreate=... -H:LayerUse=...) -->
                <webfx.native.layer.args>-H:+UnlockExperimentalVMOptions</webfx.native.layer.args>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.18</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native-layer</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <!-- Not bound to the lifecycle: invoked directly (see above) -->
                                <phase>none</phase>
                                <configuration>
                                    <buildArgs combine.children="append">
                                        <buildArg>${webfx.native.layer.args}</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${webfx.native.layer.imageName}</imageName>
                            <mainClass>${webfx.native.layer.mainClass}</mainClass>
                            ${plugin.native.configuration}
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- The reflection & resources metadata required by native-image is generated by WebFX in -->
    <!-- src/main/resources/META-INF/native-image/ and automatically picked up by native-image -->

</project>
